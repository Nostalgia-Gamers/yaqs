{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YAQS",
  "version": "0.1.0",
  "identifier": "ar.nostalgia.yaqs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Live game server watcher",
    "longDescription": "Watch your game servers and other communities' servers in real time: players, maps, ping, rules and alerts.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5RURBNUE4NkRENzg4NTcKUldSWGlOZHRxS1h0bWY4aUZNTWhvSU5OSlJtUHlqalpxbGtNTXBRdzhIMTlqZlpTN2ZtTUhqcmQK",
      "endpoints": [
        "https://github.com/Nostalgia-Gamers/yaqs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
